# Turso / libSQL
# Create a database at https://turso.tech and paste credentials below.
# Until these are set, the app uses a local SQLite file (local.db).

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared login password (same for all users). Defaults to "reiseplaner" if unset.
APP_PASSWORD=reiseplaner

# Optional: MapTiler Cloud key for the official MapTiler Basic style.
# Get a free key at https://cloud.maptiler.com/account/keys/
# Without this, the map uses the open-source MapTiler Basic style via OpenFreeMap.
PUBLIC_MAPTILER_API_KEY=
